{
  "name": "kmkt-social-ai",
  "version": "0.0.0",
  "private": true,
  "description": "KMKT Social AI — monorepo (authentication & workspace foundation)",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "node scripts/doctor/index.mjs",
    "db:generate": "pnpm --filter @kmkt/api db:generate",
    "db:migrate": "pnpm --filter @kmkt/api db:migrate",
    "db:status": "pnpm --filter @kmkt/api db:status",
    "db:reset:development": "pnpm --filter @kmkt/api db:reset:development",
    "facebook:connect": "pnpm --filter @kmkt/api facebook:connect",
    "facebook:validate": "pnpm --filter @kmkt/api facebook:validate",
    "facebook:disconnect": "pnpm --filter @kmkt/api facebook:disconnect",
    "facebook:status": "pnpm --filter @kmkt/api facebook:status",
    "facebook:group:add": "pnpm --filter @kmkt/api facebook:group:add",
    "facebook:group:list": "pnpm --filter @kmkt/api facebook:group:list",
    "facebook:group:validate": "pnpm --filter @kmkt/api facebook:group:validate",
    "facebook:group:assign": "pnpm --filter @kmkt/api facebook:group:assign",
    "facebook:group:unassign": "pnpm --filter @kmkt/api facebook:group:unassign",
    "collector:run": "pnpm --filter @kmkt/api collector:run",
    "ai-draft:generate": "pnpm --filter @kmkt/api ai-draft:generate",
    "ai-draft:list": "pnpm --filter @kmkt/api ai-draft:list",
    "ai-draft:show": "pnpm --filter @kmkt/api ai-draft:show",
    "ai-draft:regenerate": "pnpm --filter @kmkt/api ai-draft:regenerate",
    "action:create": "pnpm --filter @kmkt/api action:create",
    "action:list": "pnpm --filter @kmkt/api action:list",
    "action:show": "pnpm --filter @kmkt/api action:show",
    "action:cancel": "pnpm --filter @kmkt/api action:cancel",
    "action:retry": "pnpm --filter @kmkt/api action:retry",
    "action:recheck": "pnpm --filter @kmkt/api action:recheck",
    "backup:database": "node scripts/backup/index.mjs database",
    "backup:config": "node scripts/backup/index.mjs config",
    "backup:audit": "node scripts/backup/index.mjs audit",
    "backup:all": "node scripts/backup/index.mjs all",
    "backup:verify": "node scripts/backup/index.mjs verify",
    "backup:list": "node scripts/backup/index.mjs list",
    "backup:cleanup": "node scripts/backup/index.mjs cleanup",
    "restore:verify": "node scripts/restore/index.mjs verify",
    "restore:database": "node scripts/restore/index.mjs database",
    "restore:dry-run": "node scripts/restore/index.mjs dry-run",
    "monitor:status": "node scripts/monitor/index.mjs status",
    "monitor:check": "node scripts/monitor/index.mjs check",
    "monitor:report": "node scripts/monitor/index.mjs report",
    "logs:status": "node scripts/logs/index.mjs status",
    "logs:rotate:dry-run": "node scripts/logs/index.mjs rotate:dry-run",
    "logs:verify": "node scripts/logs/index.mjs verify",
    "facebook:profile:status": "pnpm --filter @kmkt/api facebook:profile:status",
    "facebook:profile:verify": "pnpm --filter @kmkt/api facebook:profile:verify",
    "maintenance:enable": "pnpm --filter @kmkt/api maintenance:enable",
    "maintenance:disable": "pnpm --filter @kmkt/api maintenance:disable",
    "maintenance:status": "pnpm --filter @kmkt/api maintenance:status",
    "incident:lockdown": "pnpm --filter @kmkt/api incident:lockdown",
    "incident:unlock": "pnpm --filter @kmkt/api incident:unlock",
    "incident:status": "pnpm --filter @kmkt/api incident:status"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.0.2"
  }
}
