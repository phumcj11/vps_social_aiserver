# =============================================================================
# KMKT Social AI — Example environment configuration
# =============================================================================
# This file is TRACKED in Git and contains NO real secrets.
# Copy it to `.env` (which is gitignored) and fill real values locally.
#   cp .env.example .env
#
# Safety defaults below keep the system in its safest possible state:
#   - all Facebook actions disabled
#   - human approval required
#   - global kill switch ON
#   - all concurrency pinned to 1
#   - AI, Telegram and n8n disabled
# These defaults must remain safe. Do not enable any external integration in
# SPRINT 001 (Technical Bootstrap).
# -----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_ENV=development

# --- Ports (bound to localhost / internal networks only in development) ------
WEB_PORT=3000
API_PORT=3001

# --- Database (development placeholder — NOT a real credential) --------------
# Inside Docker Compose, services reach MySQL at host `mysql`. When running the
# API or migrations directly on the host, use `127.0.0.1` (MySQL is published on
# loopback only, never on a public interface).
#   In-container:  mysql://kmkt_social_ai:change_me@mysql:3306/kmkt_social_ai
#   On host:       mysql://kmkt_social_ai:change_me@127.0.0.1:3306/kmkt_social_ai
DATABASE_URL=mysql://kmkt_social_ai:change_me@127.0.0.1:3306/kmkt_social_ai

# MySQL container bootstrap values (development placeholders — NOT real secrets).
# Replace in your local .env before running the stack in a later sprint.
MYSQL_DATABASE=kmkt_social_ai
MYSQL_USER=kmkt_social_ai
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# Host bind address for the API (internal by default; never 0.0.0.0 publicly).
API_HOST=127.0.0.1

# --- Facebook adapter — reader/comment/write DISABLED (later sprints) --------
FACEBOOK_READER_ENABLED=false
FACEBOOK_COMMENT_ENABLED=false
FACEBOOK_WRITE_ACTION_ENABLED=false
# Facebook login (SPRINT 004). Keep FALSE by default: no real browser launches
# and the connection is recorded as login-disabled. An operator sets this to
# true ONLY in a local .env to run the operator-assisted browser login.
# Enabling this does NOT grant permission to scan or comment.
FACEBOOK_LOGIN_ENABLED=false

# Per-workspace persistent browser-profile root (relative to the repo). Server-
# generated paths only; NEVER commit profile contents (see .gitignore).
BROWSER_PROFILE_ROOT=storage/browser-profiles
# Connection / validation run timeouts (milliseconds). No infinite retries.
FACEBOOK_CONNECT_TIMEOUT_MS=180000
FACEBOOK_VALIDATE_TIMEOUT_MS=60000

# --- Collector Engine (SPRINT 006, read-only) -------------------------------
# The Collector reads Group posts and stores them as Signals. Reading is gated
# by FACEBOOK_READER_ENABLED (above): when false (default) NO browser launches
# and runs complete with 0 posts. The Collector never writes to Facebook.
COLLECTOR_MAX_SCROLLS=5
COLLECTOR_MAX_POSTS_PER_GROUP=30
COLLECTOR_TIMEOUT_MS=120000

# --- Opportunity Classifier (SPRINT 007, deterministic) ---------------------
# The Classifier decides whether a Signal becomes an Opportunity using pure
# deterministic rules — NO AI, NO ML, NO business matching. A Signal whose text
# is shorter than the minimum length below fails the TEXT_MIN_LENGTH rule.
OPPORTUNITY_MIN_TEXT_LENGTH=15

# --- Safety guarantees ------------------------------------------------------
# Human approval is mandatory before every comment; the kill switch halts all
# new Facebook write actions. Both must stay in their safe state by default.
COMMENT_APPROVAL_REQUIRED=true
GLOBAL_KILL_SWITCH=true

# --- Action Queue Engine (SPRINT 011) ---------------------------------------
# A SAFE BOUNDARY between an approved Human Review decision and future platform
# execution. This sprint does NOT execute Facebook actions and runs NO Action
# Worker. Execution is disabled by default; combined with FACEBOOK_WRITE_ACTION_
# ENABLED=false and GLOBAL_KILL_SWITCH=true, every Action Job is created BLOCKED
# and never executes. Only facebook_comment is selectable in the MVP.
ACTION_ENGINE_ENABLED=false
ACTION_DEFAULT_MAX_ATTEMPTS=3
ACTION_ALLOWED_TYPES=facebook_comment
ACTION_EXECUTION_CONCURRENCY=1

# --- Facebook Comment Adapter & Safe Execution (SPRINT 012) -----------------
# The Action Executor runs the narrow Facebook Comment Adapter behind a small
# stable interface. It defaults to the deterministic FAKE adapter (no network,
# no Playwright, no real write). The real 'playwright' adapter REFUSES to submit
# unless ALL of these are intentionally set: ACTION_ENGINE_ENABLED=true,
# FACEBOOK_WRITE_ACTION_ENABLED=true, FACEBOOK_COMMENT_ENABLED=true,
# GLOBAL_KILL_SWITCH=false, FACEBOOK_COMMENT_ADAPTER=playwright. Ambiguous
# results NEVER auto-retry. No real comment is posted this sprint.
FACEBOOK_COMMENT_ADAPTER=fake
FACEBOOK_COMMENT_EXECUTION_TIMEOUT_MS=90000
FACEBOOK_COMMENT_VERIFY_TIMEOUT_MS=30000
FACEBOOK_COMMENT_MAX_ATTEMPTS=1
ACTION_EVIDENCE_RETENTION_DAYS=30
ACTION_AMBIGUOUS_AUTO_RETRY=false

# --- Concurrency (conservative for 2 CPU cores / 3.8 GiB RAM) ---------------
PLAYWRIGHT_CONCURRENCY=1
SCANNER_CONCURRENCY=1
COMMENT_CONCURRENCY=1

# --- External integrations — DISABLED (reserved for later sprints) ----------
AI_ENABLED=false
# TELEGRAM_ENABLED (SPRINT 010) gates the Telegram Review ADAPTER transport only.
# The Human Review Engine is the core and works WITHOUT Telegram; when false
# (default) the adapter refuses to send and delivery is skipped best-effort. A
# review decision NEVER posts to Facebook regardless of this flag. No bot is
# connected this sprint. Future secret (documented only — DO NOT populate here;
# supply via the gitignored .env after TELEGRAM_ENABLED is intentionally set):
#   TELEGRAM_BOT_TOKEN=       # (unset) real bot token — never commit
TELEGRAM_ENABLED=false
N8N_ENABLED=false

# --- AI Draft Engine (SPRINT 009) -------------------------------------------
# Produces DRAFT comment suggestions for human review ONLY. A draft is NEVER
# sent to Telegram, NEVER posted to Facebook, and NEVER triggers a write action.
# AI is DISABLED by default; the deterministic Mock provider is used for tests
# and local use. A real external provider MUST refuse to run while AI_ENABLED=false.
AI_PROVIDER=mock
AI_MODEL=mock-draft-v1
AI_PROMPT_VERSION=rules-v1
AI_DRAFT_MAX_LENGTH=500
AI_CONTEXT_MAX_KNOWLEDGE_ITEMS=20
AI_CONTEXT_MAX_CHARACTERS=12000
# Future real-provider secrets (names documented only — DO NOT populate here;
# supply via the gitignored .env, and only after AI_ENABLED is intentionally set):
#   ANTHROPIC_API_KEY=        # (unset) real provider key — never commit
#   AI_PROVIDER_BASE_URL=     # (unset) optional provider endpoint override

# --- Authentication & sessions (SPRINT 002) ---------------------------------
# Session cookie name and lifetime. Tokens are opaque, random, and stored only
# as a SHA-256 hash server-side; the raw token lives only in the HttpOnly cookie.
SESSION_COOKIE_NAME=kmkt_session
SESSION_TTL_HOURS=168
# Secure cookie attribute. Forced ON automatically when APP_ENV=production.
SESSION_COOKIE_SECURE=false
# Minimum password length enforced on registration.
PASSWORD_MIN_LENGTH=10

# --- CORS -------------------------------------------------------------------
# The single known web origin allowed to call the API with credentials.
# NEVER use a wildcard, especially in production.
WEB_ORIGIN=http://localhost:3000

# --- Auth rate-limit foundation ---------------------------------------------
# Applied to /auth/register and /auth/login (per client, per window).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# --- Action / execution rate limits (SPRINT 012) ----------------------------
# Per-client, per-window guards on the write/expensive endpoints.
ACTION_CREATE_RATE_LIMIT_MAX=30
ACTION_CREATE_RATE_LIMIT_WINDOW_SECONDS=60
EXECUTION_PREPARE_RATE_LIMIT_MAX=10
EXECUTION_PREPARE_RATE_LIMIT_WINDOW_SECONDS=60
EXECUTION_RECOVER_RATE_LIMIT_MAX=10
EXECUTION_RECOVER_RATE_LIMIT_WINDOW_SECONDS=60

# --- Web app (public, build-time) -------------------------------------------
# Base URL the browser uses to reach the API. NEXT_PUBLIC_* is inlined at build.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# --- Retention & logging ----------------------------------------------------
SCREENSHOT_RETENTION_DAYS=30
LOG_LEVEL=info
